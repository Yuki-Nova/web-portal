---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchModal from '../components/SearchModal.vue';
import YukiSnow from '../components/YukiSnow.vue';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** 分享图：相对 public/ 的路径或绝对 URL；缺省用 /og-default.png */
  image?: string;
  /** OG 类型：普通页面 website，文章详情页 article */
  type?: 'website' | 'article';
}

const {
  title = "yuki's stop",
  description = '诗词、照片与工具',
  image = '/og-default.png',
  type = 'website',
} = Astro.props;

const currentPath = Astro.url.pathname;
// 搜索索引不再内联到页面，改由 SearchModal 打开时按需拉取 /search-index.json

// 社交分享元数据（canonical / OG / Twitter Card）。
// astro.config.mjs 已设 site，故这里一律用绝对 URL —— OG 协议要求绝对地址。
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(image, Astro.site);
const SITE_NAME = "yuki's stop";
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- canonical + 社交分享（OG / Twitter Card）。
         og:image 必须是绝对 URL；默认图 public/og-default.png 由
         scripts/make-og-image.py 生成（见该脚本头部说明）。 -->
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Google Fonts（异步加载）：media=print 先不参与渲染阻塞，加载完再切回 all。
         外网不可达时首屏不会再被字体请求拖住；无 JS 场景由 noscript 兜底。 -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Noto+Serif+SC:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Noto+Serif+SC:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      />
    </noscript>

    <!-- Astro View Transitions for seamless app-like navigation -->
    <ClientRouter />

    <!-- 主题应用：首次加载防 FOUC + 客户端导航后重新应用。
         View Transitions 的 swap 会用新页面的 <html> 属性覆盖当前文档，而 SSR 输出的
         <html> 不带 data-theme，属性被抹掉 → 换页时闪一下昼模式（localStorage 里其实
         还记着夜模式，所以刷新又恢复）。故监听 astro:after-swap 把主题补回来。 -->
    <script is:inline>
      (function () {
        function applyTheme() {
          try {
            var t = localStorage.getItem('shiro-theme');
            if (!t) {
              t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            }
            if (t === 'dark') {
              document.documentElement.setAttribute('data-theme', 'dark');
            } else {
              document.documentElement.removeAttribute('data-theme');
            }
          } catch (e) {}
        }

        applyTheme();

        // 内联脚本在每次客户端导航时可能被重新执行，用标志位避免重复注册监听
        if (!window.__shiroThemeWatcher) {
          window.__shiroThemeWatcher = true;
          document.addEventListener('astro:after-swap', applyTheme);
        }
      })();
    </script>
  </head>
  <body class="bg-canvas text-ink antialiased min-h-screen flex flex-col font-sans transition-colors duration-200">
    <!-- 随风碎雪背景层（Task 5.1）：fixed + z-0 + pointer-events:none，
         不接管任何鼠标事件。main / footer 只加 position:relative（**不要**加 z-index）：
         它们与雪层同属「定位元素」这一绘制层，靠 DOM 顺序即可压在雪层之上；
         一旦给 main 加 z-index，就会建出层叠上下文，把内部的固定挂件
         （如文章页的阅读印章 z-40）关在里面，反被排在后面的 footer 盖住。 -->
    <YukiSnow client:idle />

    <Header currentPath={currentPath} />
    <main class="relative flex-1 w-full max-w-5xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
      <slot />
    </main>
    <Footer />

    {/* 搜索弹窗必须挂在 body 末尾（不在 Header 的 backdrop-blur 容器内，
        才能用 fixed 覆盖全屏），且不能用 Vue 的 Teleport —— 见 AGENTS.md 坑点一。
        触发按钮在 Header 内（SearchTrigger），通过 shiro:open-search 事件通信。 */}
    <SearchModal client:idle />

    <!-- 装饰性交互脚本（落印涟漪 Task 1.1 / 游丝光标 Task 1.2 / 宣纸微倾 Task 2.1+2.2）。
         Astro 会把这些 `<script src="...">` 作为模块打包，**每个页面只执行一次**；
         ClientRouter 换页时模块不重跑，页面级初始化统一走 motion.js 的 onPageLoad()。
         触屏与 prefers-reduced-motion 下各自静默降级，不做任何注册。 -->
    <script src="../scripts/stamp-ripple.js"></script>
    <script src="../scripts/paper-tilt.js"></script>
    <script src="../scripts/ink-cursor.js"></script>
  </body>
</html>
