---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchModal from '../components/SearchModal.vue';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "yuki's stop · 纸墨书斋",
  description = "古典诗词、影像策展与学术工具的数字空间",
} = Astro.props;

const currentPath = Astro.url.pathname;
// 搜索索引不再内联到页面，改由 SearchModal 打开时按需拉取 /search-index.json
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Google Fonts（异步加载）：media=print 先不参与渲染阻塞，加载完再切回 all。
         外网不可达时首屏不会再被字体请求拖住；无 JS 场景由 noscript 兜底。 -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Noto+Serif+SC:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Noto+Serif+SC:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      />
    </noscript>

    <!-- Astro View Transitions for seamless app-like navigation -->
    <ClientRouter />

    <!-- Early FOUC Prevention Script -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('shiro-theme');
          if (!t) {
            t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          if (t === 'dark') {
            document.documentElement.setAttribute('data-theme', 'dark');
          } else {
            document.documentElement.removeAttribute('data-theme');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="bg-canvas text-ink antialiased min-h-screen flex flex-col font-sans transition-colors duration-200">
    <Header currentPath={currentPath} />
    <main class="flex-1 w-full max-w-5xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
      <slot />
    </main>
    <Footer />

    {/* 搜索弹窗必须挂在 body 末尾（不在 Header 的 backdrop-blur 容器内，
        才能用 fixed 覆盖全屏），且不能用 Vue 的 Teleport —— 见 AGENTS.md 坑点一。
        触发按钮在 Header 内（SearchTrigger），通过 shiro:open-search 事件通信。 */}
    <SearchModal client:idle />
  </body>
</html>
