---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GalleryView from '../../components/GalleryView.vue';
---

<BaseLayout title="影廊 · yuki's stop" description="个人照片">
  <div class="py-4 sm:py-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-border-paper pb-6 mb-8">
      <div>
        <h1 class="text-2xl sm:text-3xl font-serif font-bold text-ink">
          影廊
        </h1>
      </div>
      <div class="text-xs text-ink-muted font-mono">
        个人照片
      </div>
    </div>

    <!-- Gallery View Component -->
    <GalleryView client:load />
  </div>
</BaseLayout>
