---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GalleryView from '../../components/GalleryView.vue';
import galleryData from '../../data/gallery.json';
---

<BaseLayout title="极简影廊 · yuki's stop" description="个人摄影与插画策展空间，纯静态极简画廊">
  <div class="py-4 sm:py-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-border-paper pb-6 mb-8">
      <div>
        <div class="inline-flex items-center gap-2 text-xs font-serif text-seal mb-2">
          <span class="w-1.5 h-1.5 rounded-full bg-seal"></span>
          <span>特种纸策展影廊</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-serif font-bold text-ink">
          光影留痕 · 瞬息与永恒
        </h1>
      </div>
      <div class="text-xs text-ink-muted font-mono">
        OSS + CDN · 纯静态直出
      </div>
    </div>

    <!-- Gallery View Component -->
    <GalleryView client:load images={galleryData} />
  </div>
</BaseLayout>
