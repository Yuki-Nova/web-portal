---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 · yuki's stop" description="页面不存在">
  <div class="flex flex-col items-center justify-center text-center py-16 sm:py-24">
    <span class="seal-badge w-14 h-14 text-2xl mb-6 select-none">阙</span>

    <h1 class="text-3xl sm:text-4xl font-serif font-bold text-ink tracking-widest mb-3">
      404
    </h1>
    <p class="text-sm font-serif text-ink-muted tracking-wide mb-10">
      页面不存在
    </p>

    <div class="flex flex-wrap items-center justify-center gap-3 text-xs font-serif">
      <a href="/" class="paper-card px-4 py-2 no-underline text-ink hover:text-seal transition-colors">返回首页</a>
      <a href="/poems" class="paper-card px-4 py-2 no-underline text-ink hover:text-seal transition-colors">诗词墙</a>
      <a href="/archives" class="paper-card px-4 py-2 no-underline text-ink hover:text-seal transition-colors">文集编年</a>
      <a href="/images" class="paper-card px-4 py-2 no-underline text-ink hover:text-seal transition-colors">影廊</a>
    </div>
  </div>
</BaseLayout>
