---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SidebarProfile from '../../components/SidebarProfile.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const allPosts = await getCollection('blog');
const categoriesSet = new Set<string>();
const tagsSet = new Set<string>();

allPosts.forEach((p) => {
  p.data.categories?.forEach((c) => categoriesSet.add(c));
  p.data.tags?.forEach((t) => tagsSet.add(t));
});

const formatDate = (d?: string | Date) => {
  if (!d) return '';
  return new Date(d).toLocaleDateString('zh-CN', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  });
};
---

<BaseLayout title={`${post.data.title} · yuki's stop`} description={post.data.title}>
  <div class="max-w-6xl mx-auto py-4">
    <!-- Breadcrumb back link -->
    <div class="mb-6">
      <a
        href="/blog"
        class="inline-flex items-center gap-1.5 text-xs font-serif text-ink-muted hover:text-seal transition-colors no-underline"
      >
        <span>← 返回博客文集</span>
      </a>
    </div>

    <!-- Two-Column Grid: Article Content + Sidebar -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Main Article Column (8 cols) -->
      <article class="lg:col-span-8 paper-card p-6 sm:p-12 relative overflow-hidden">
        <!-- Watermark -->
        <div class="absolute -right-8 -bottom-8 text-9xl font-serif text-ink opacity-[0.02] select-none pointer-events-none">
          墨
        </div>

        <!-- Post Header -->
        <header class="border-b border-border-paper pb-6 mb-8 text-center sm:text-left">
          <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2 text-xs font-mono text-ink-muted mb-3">
            <span>{formatDate(post.data.date)}</span>
            {post.data.categories?.map((cat) => (
              <a href={`/categories#cat-${encodeURIComponent(cat)}`} class="px-2 py-0.5 rounded bg-black/5 dark:bg-white/5 font-serif text-[11px] text-ink-muted hover:text-seal no-underline">
                {cat}
              </a>
            ))}
            {post.data.tags?.map((t) => (
              <a href={`/tags#tag-${encodeURIComponent(t)}`} class="px-2 py-0.5 rounded bg-seal/5 font-serif text-[11px] text-seal border border-seal/15 hover:bg-seal/10 no-underline">
                {t}
              </a>
            ))}
          </div>

          <h1 class="text-3xl sm:text-4xl font-serif font-bold text-ink tracking-wider">
            {post.data.title}
          </h1>
        </header>

        <!-- Post Markdown Content -->
        <div class="prose dark:prose-invert max-w-none font-serif text-base sm:text-lg text-ink leading-loose tracking-wide space-y-4">
          <Content />
        </div>

        <!-- Post Footer / Seal Stamp -->
        <footer class="mt-12 pt-6 border-t border-border-paper flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-serif text-ink-muted">
          <div class="flex items-center gap-2">
            <span class="w-6 h-6 seal-badge text-xs select-none">
              雪
            </span>
            <span>yuki's stop · 诗文存鉴</span>
          </div>

          <div class="flex items-center gap-2 font-mono text-[11px]">
            <span>文成钤印 · 归真返朴</span>
          </div>
        </footer>
      </article>

      <!-- Right Sidebar (4 cols): Profile Card (Image 2) + Table of Contents -->
      <div class="lg:col-span-4 sticky top-20">
        <SidebarProfile
          postCount={allPosts.length}
          catCount={categoriesSet.size}
          tagCount={tagsSet.size}
          toc={headings}
        />
      </div>
    </div>
  </div>
</BaseLayout>
