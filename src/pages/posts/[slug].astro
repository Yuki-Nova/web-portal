---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PoemCardExport from '../../components/PoemCardExport.vue';
import ReadingSeal from '../../components/ReadingSeal.vue';
import { toExcerpt } from '../../utils/excerpt.js';
import { countWords, readingMinutes } from '../../utils/reading.js';
import { splitPoemGroups } from '../../utils/poem-card.js';

export async function getStaticPaths() {
  const posts = await getCollection('blog');

  // 按日期倒序（新 → 旧），用于推导相邻篇目
  const sorted = [...posts].sort((a, b) => {
    const da = a.data.date ? new Date(a.data.date).getTime() : 0;
    const db = b.data.date ? new Date(b.data.date).getTime() : 0;
    return db - da;
  });

  return sorted.map((post, index) => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: {
      post,
      // 与旧站 Hexo 语义一致：prev = 时间上更早的一篇，next = 更新的一篇
      prev: sorted[index + 1] ?? null,
      next: sorted[index - 1] ?? null,
    },
  }));
}

const { post, prev, next } = Astro.props;
const { Content, headings } = await render(post);

const slugOf = (p: { id: string }) => encodeURIComponent(p.id.replace(/\.md$/, ''));

const formatDate = (d?: string | Date) => {
  if (!d) return '';
  return new Date(d).toLocaleDateString('zh-CN', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  });
};

// 摘要：与 RSS 订阅源共用同一套口径（src/utils/excerpt.js）
const excerpt = toExcerpt(post);

// 字数与阅读时长（src/utils/reading.js）
const { total: charCount } = countWords(post);
const minutes = readingMinutes(charCount);

// 长文目录：只收 h2/h3（h1 即标题本身，h4 以下太碎）。
// 当前 81 篇诗词都没有 markdown 标题，因此通常不渲染；等长文（辞赋/杂感）开始用
// `##` 小节标题时它会自动出现，不需要再改这里。
const tocItems = (headings ?? []).filter((h) => h.depth === 2 || h.depth === 3);
const showToc = tocItems.length >= 3;

// 笺纸卡片导出的竖排正文（只切分、不改字；标点保留在每列末尾）
const poemGroups = splitPoemGroups(post.body);
---

<BaseLayout
  title={`${post.data.title} · yuki's stop`}
  description={excerpt}
  type="article"
>
  <div class="max-w-3xl mx-auto py-4">
    <!-- 返回诗词墙 -->
    <div class="mb-6">
      <a
        href="/poems"
        class="inline-flex items-center gap-1.5 text-xs font-serif text-ink-muted hover:text-seal transition-colors no-underline"
      >
        <span>← 返回诗词墙</span>
      </a>
    </div>

    <!-- 长文折叠目录：小节标题 ≥3 个才出现。当前 81 篇诗词都没有 markdown 标题，
         所以通常不渲染；等辞赋/杂感开始用 `##` 分节时自动生效。 -->
    {showToc && (
      <details class="paper-card px-5 py-4 mb-6 group">
        <summary class="cursor-pointer list-none flex items-center justify-between text-xs font-serif text-ink-muted hover:text-seal transition-colors">
          <span>目录 · 共 {tocItems.length} 节</span>
          <span class="font-mono transition-transform group-open:rotate-90">▸</span>
        </summary>
        <ul class="mt-3 space-y-1.5">
          {tocItems.map((h) => (
            <li class={h.depth === 3 ? 'pl-5' : ''}>
              <a
                href={`#${h.slug}`}
                class="text-sm font-serif text-ink-muted hover:text-seal no-underline transition-colors"
              >
                {h.text}
              </a>
            </li>
          ))}
        </ul>
      </details>
    )}

    <!-- 居中单栏正文（原先的右栏个人信息卡与目录已移除） -->
    <article
      class="paper-card p-6 sm:p-12 relative overflow-hidden min-h-[460px] sm:min-h-[520px] flex flex-col justify-between transition-all duration-300"
      transition:name="post-card"
    >
      <!-- Watermark -->
      <div class="absolute -right-8 -bottom-8 text-9xl font-serif text-ink opacity-[0.02] select-none pointer-events-none">
        墨
      </div>

      <div class="flex-1">
        <!-- Post Header -->
        <header class="border-b border-border-paper pb-6 mb-8 text-center sm:text-left">
          <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2 text-xs font-mono text-ink-muted mb-3">
            <span>{formatDate(post.data.date)}</span>
            {charCount > 0 && (
              <span class="text-ink-faint">{charCount} 字 · 约 {minutes} 分钟</span>
            )}
            {post.data.categories?.map((cat) => (
              <a href={`/categories/${encodeURIComponent(cat)}/`} class="px-2 py-0.5 rounded bg-black/5 dark:bg-white/5 font-serif text-[11px] text-ink-muted hover:text-seal no-underline">
                {cat}
              </a>
            ))}
            {post.data.tags?.map((t) => (
              <a href={`/tags/${encodeURIComponent(t)}/`} class="px-2 py-0.5 rounded bg-seal/5 font-serif text-[11px] text-seal border border-seal/15 hover:bg-seal/10 no-underline">
                {t}
              </a>
            ))}
          </div>

          <h1 class="text-3xl sm:text-4xl font-serif font-bold text-ink tracking-wider">
            {post.data.title}
          </h1>
        </header>

        <!-- Post Markdown Content -->
        <div class="prose max-w-none text-base sm:text-lg">
          <Content />
        </div>
      </div>

      <!-- Post Footer / Seal Stamp -->
      <footer class="mt-12 pt-6 border-t border-border-paper flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-serif text-ink-muted">
        <div class="flex items-center gap-2">
          <span class="w-6 h-6 seal-badge text-xs select-none">
            雪
          </span>
          <span>yuki's stop</span>
        </div>

      </footer>
    </article>

    <!-- 笺纸卡片导出（客户端岛：canvas 渲染 + 下载/复制）。
         用 client:visible —— 它在首屏之下，滚到才 hydration，不拖首屏。 -->
    <PoemCardExport
      client:visible
      title={post.data.title}
      groups={poemGroups}
      date={formatDate(post.data.date)}
      tags={post.data.tags ?? []}
    />

    <!-- 阅读进度印章（Task 4.1）：fixed 右下角，滚动注墨、点击回顶。
         必须放在正文 article 之外 —— article 带 transition:name（换页过渡快照），
         且 [data-tilt] 之类的 transform 会改变 fixed 的包含块。 -->
    <ReadingSeal client:idle />

    <!-- 上一篇 / 下一篇（与旧站 post.njk 的 prev/next 导航对应） -->
    {(prev || next) && (
      <nav class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-3">
        {prev ? (
          <a href={`/posts/${slugOf(prev)}`} class="paper-card p-4 no-underline group flex flex-col gap-1">
            <span class="text-[10px] font-mono text-ink-faint">← 上一篇</span>
            <span class="font-serif text-sm text-ink group-hover:text-seal transition-colors truncate">
              {prev.data.title}
            </span>
          </a>
        ) : (
          <span aria-hidden="true"></span>
        )}

        {next && (
          <a href={`/posts/${slugOf(next)}`} class="paper-card p-4 no-underline group flex flex-col gap-1 sm:text-right">
            <span class="text-[10px] font-mono text-ink-faint">下一篇 →</span>
            <span class="font-serif text-sm text-ink group-hover:text-seal transition-colors truncate">
              {next.data.title}
            </span>
          </a>
        )}
      </nav>
    )}
  </div>
</BaseLayout>
