---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// 分类索引页：只列分类与篇数（文章列表挪到 /categories/<分类>/ 并按 20 篇分页）
const allPosts = await getCollection('blog');

const categoryMap: Record<string, number> = {};
allPosts.forEach((post) => {
  const cats = post.data.categories && post.data.categories.length > 0
    ? post.data.categories
    : ['未分类'];
  cats.forEach((c) => {
    categoryMap[c] = (categoryMap[c] || 0) + 1;
  });
});

const sortedCategories = Object.keys(categoryMap).sort(
  (a, b) => categoryMap[b] - categoryMap[a]
);
---

<BaseLayout title="分类 · yuki's stop" description="按体裁分类">
  <div class="py-4 sm:py-6 max-w-4xl mx-auto">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-border-paper pb-6 mb-8">
      <div>
        <div class="inline-flex items-center gap-2 text-xs font-serif text-seal mb-2">
          <span class="w-1.5 h-1.5 rounded-full bg-seal"></span>
          <span>分类</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-serif font-bold text-ink">
          分类
        </h1>
      </div>
      <div class="text-xs text-ink-muted font-mono">
        共 {sortedCategories.length} 个分类 · {allPosts.length} 篇
      </div>
    </div>

    <!-- Category Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-4">
      {sortedCategories.map((cat) => (
        <a
          href={`/categories/${encodeURIComponent(cat)}/`}
          class="paper-card p-5 no-underline group flex items-center justify-between gap-3"
          data-tilt
        >
          <span class="font-serif font-semibold text-sm text-ink group-hover:text-seal transition-colors">
            {cat}
          </span>
          <span class="text-[11px] font-mono text-ink-muted bg-black/5 dark:bg-white/5 px-2 py-0.5 rounded flex-shrink-0">
            {categoryMap[cat]} 篇
          </span>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
