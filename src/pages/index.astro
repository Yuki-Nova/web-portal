---
import BaseLayout from '../layouts/BaseLayout.astro';

// 门户入口。首页不再自带独立 HTML 骨架，统一走 BaseLayout（顶部导航 + 页脚）。
const entries = [
  { label: '诗词墙', desc: '依体裁与意象检索诗作', href: '/blog' },
  { label: '填词案头', desc: '153 词牌 · 平仄校验', href: '/poetry' },
  { label: '极简影廊', desc: '影像策展空间', href: '/images' },
  { label: '文集编年', desc: '按年岁检索全稿', href: '/archives' },
  { label: '学术工作台', desc: '教材解析 · 独立站点', href: 'https://bookswich.yukinova.top', external: true },
  { label: 'GitHub', desc: '源码与项目', href: 'https://github.com/Yuki-Nova', external: true },
];
---

<BaseLayout title="Yuki-Nova · 个人名片" description="Yuki-Nova 的个人数字空间与文墨书斋">
  <div class="flex flex-col items-center text-center py-6 sm:py-14 animate-fade-in">
    <!-- 圆头像 -->
    <div class="relative mb-5 group">
      <img
        src="https://github.com/Yuki-Nova.png"
        alt="Yuki-Nova"
        class="w-28 h-28 sm:w-32 sm:h-32 rounded-full object-cover border-2 border-border-paper shadow-paper transition-transform duration-500 group-hover:scale-105"
        loading="eager"
      />
    </div>

    <!-- 名号与自述 -->
    <h1 class="text-3xl sm:text-4xl font-serif font-bold text-ink tracking-widest mb-2">
      Yuki-Nova
    </h1>
    <p class="text-xs sm:text-sm font-sans text-ink-muted tracking-wider mb-10">
      Software Developer · Classical Poet · Photography Enthusiast
    </p>

    <!-- 门户入口卡片 -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-4 w-full max-w-3xl text-left">
      {entries.map((entry) => (
        <a
          href={entry.href}
          target={entry.external ? '_blank' : undefined}
          rel={entry.external ? 'noopener noreferrer' : undefined}
          class="paper-card p-4 sm:p-5 no-underline group"
        >
          <div class="font-serif font-semibold text-sm text-ink group-hover:text-seal transition-colors flex items-center justify-between gap-2">
            <span>{entry.label}</span>
            <span class="text-ink-faint group-hover:text-seal group-hover:translate-x-0.5 transition-all text-xs">→</span>
          </div>
          <p class="text-[11px] font-serif text-ink-muted mt-1">{entry.desc}</p>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
