---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Pagination from '../../components/Pagination.astro';
import { getCollection } from 'astro:content';

// 构建期分页：每页 20 篇（与旧站 Hexo 的 per_page 一致），
// 生成 /archives、/archives/2、/archives/3 … 避免单页塞下全部 80 篇。
export async function getStaticPaths({ paginate }) {
  const posts = await getCollection('blog');
  const sorted = posts.sort((a, b) => {
    const da = a.data.date ? new Date(a.data.date).getTime() : 0;
    const db = b.data.date ? new Date(b.data.date).getTime() : 0;
    return db - da;
  });

  return paginate(sorted, { pageSize: 20 });
}

const { page } = Astro.props;
const allPosts = await getCollection('blog');

// 页内按年分组
const yearMap: Record<string, typeof page.data> = {};
page.data.forEach((post) => {
  const year = post.data.date ? new Date(post.data.date).getFullYear().toString() : '早期';
  if (!yearMap[year]) yearMap[year] = [];
  yearMap[year].push(post);
});

const sortedYears = Object.keys(yearMap).sort((a, b) => b.localeCompare(a));

const formatDate = (d?: string | Date) => {
  if (!d) return '';
  const dateObj = new Date(d);
  return `${(dateObj.getMonth() + 1).toString().padStart(2, '0')}-${dateObj.getDate().toString().padStart(2, '0')}`;
};

const pageTitle = page.currentPage > 1
  ? `归档 · 第 ${page.currentPage} 页 · yuki's stop`
  : "归档 · yuki's stop";
---

<BaseLayout title={pageTitle} description="依光阴年岁排布之全部诗作与文集年表">
  <div class="py-4 sm:py-6 max-w-4xl mx-auto">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-border-paper pb-6 mb-8">
      <div>
        <div class="inline-flex items-center gap-2 text-xs font-serif text-seal mb-2">
          <span class="w-1.5 h-1.5 rounded-full bg-seal"></span>
          <span>归档</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-serif font-bold text-ink">
          全部诗作
        </h1>
      </div>
      <div class="text-xs text-ink-muted font-mono">
        共 {allPosts.length} 篇
      </div>
    </div>

    <!-- Timeline Sections by Year -->
    <div class="space-y-12">
      {sortedYears.map((year) => (
        <section class="paper-card p-6 sm:p-8">
          <div class="flex items-center justify-between border-b border-border-paper pb-4 mb-6">
            <h2 class="text-2xl font-serif font-bold text-ink flex items-center gap-2.5">
              <span class="w-2.5 h-2.5 rounded-full bg-seal"></span>
              <span>{year} 年</span>
            </h2>
            <span class="text-xs font-mono text-ink-muted">
              {yearMap[year].length} 篇
            </span>
          </div>

          <div class="divide-y divide-border-paper">
            {yearMap[year].map((post) => {
              const slug = post.id.replace(/\.md$/, '');
              return (
                <article class="py-3 flex items-center justify-between gap-4 group">
                  <div class="flex items-center gap-3 min-w-0">
                    <span class="text-xs font-mono text-ink-faint w-16 flex-shrink-0">
                      {formatDate(post.data.date)}
                    </span>
                    <a
                      href={`/posts/${encodeURIComponent(slug)}`}
                      class="font-serif text-sm sm:text-base text-ink group-hover:text-seal transition-colors truncate no-underline font-medium"
                    >
                      {post.data.title}
                    </a>
                  </div>

                  <div class="flex items-center gap-2 flex-shrink-0 text-xs text-ink-muted">
                    {post.data.tags?.slice(0, 1).map((t) => (
                      <span class="text-[10px] font-serif text-seal px-1.5 py-0.5 rounded bg-seal/5">
                        {t}
                      </span>
                    ))}
                    <span class="group-hover:translate-x-1 transition-transform">→</span>
                  </div>
                </article>
              );
            })}
          </div>
        </section>
      ))}
    </div>

    <!-- 分页 -->
    <Pagination
      currentPage={page.currentPage}
      lastPage={page.lastPage}
      prevUrl={page.url.prev}
      nextUrl={page.url.next}
    />
  </div>
</BaseLayout>
