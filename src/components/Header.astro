---
import ThemeToggle from './ThemeToggle.vue';
import SearchModal from './SearchModal.vue';

interface Props {
  currentPath?: string;
  searchPosts?: Array<{
    slug: string;
    title: string;
    date: string;
    categories: string[];
    tags: string[];
    body: string;
  }>;
}

const { currentPath = '/', searchPosts = [] } = Astro.props;

// Nav links with icons matching Image 1
const navItems = [
  { label: '首页', href: '/', icon: '🏰' },
  { label: '博客', href: '/blog', icon: '📝' },
  { label: '填词', href: '/poetry', icon: '📜' },
  { label: '相册', href: '/images', icon: '📷' },
  { label: '分类', href: '/categories', icon: '📁' },
  { label: '标签', href: '/tags', icon: '🏷️' },
  { label: '归档', href: '/archives', icon: '📰' },
  { label: '工作台', href: 'https://bookswich.yukinova.top', icon: '⚙️', external: true },
];
---

<header class="sticky top-0 z-50 w-full border-b border-[#2b2d31] bg-[#1a1c20]/95 dark:bg-[#121316]/95 backdrop-blur-md text-white transition-colors duration-200">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between gap-4">
    <!-- Left: Utility Icons (Theme Toggle + Search) as in Image 1 -->
    <div class="flex items-center gap-1.5 sm:gap-2 flex-shrink-0">
      <ThemeToggle client:load />
      <SearchModal client:idle posts={searchPosts} />
    </div>

    <!-- Center/Right: Brand Name + Project Buttons with Icons (Image 1 Style) -->
    <nav class="flex items-center gap-3 sm:gap-6 overflow-x-auto no-scrollbar">
      <!-- Site Brand Name -->
      <a href="/" class="font-serif font-bold text-white/95 hover:text-white text-sm sm:text-base tracking-wider no-underline flex-shrink-0 transition-colors">
        Yuki's World
      </a>

      <!-- Navigation Items with Emojis & Bold Underline Active Indicator -->
      <div class="flex items-center gap-1 sm:gap-3 text-xs sm:text-sm font-serif">
        {navItems.map((item) => {
          const isActive = !item.external && (
            item.href === '/'
              ? currentPath === '/'
              : currentPath.startsWith(item.href)
          );
          return (
            <a
              href={item.href}
              target={item.external ? '_blank' : undefined}
              rel={item.external ? 'noopener noreferrer' : undefined}
              class={`relative px-2 sm:px-2.5 py-4 transition-colors flex items-center gap-1.5 flex-shrink-0 no-underline ${
                isActive
                  ? 'text-white font-semibold'
                  : 'text-white/60 hover:text-white/90'
              }`}
            >
              <span class="text-xs sm:text-sm">{item.icon}</span>
              <span>{item.label}</span>
              {/* Bold Underline for Active Item (Image 1 Style) */}
              {isActive && (
                <span class="absolute bottom-0 left-1 right-1 h-[2.5px] bg-white rounded-full"></span>
              )}
            </a>
          );
        })}
      </div>
    </nav>

    <!-- Empty Spacer on Far Right for Balance -->
    <div class="hidden sm:block w-12 flex-shrink-0"></div>
  </div>
</header>
