---
interface Props {
  postCount?: number;
  catCount?: number;
  tagCount?: number;
  toc?: Array<{ depth: number; slug: string; text: string }>;
}

const {
  postCount = 80,
  catCount = 4,
  tagCount = 10,
  toc = [],
} = Astro.props;
---

<aside class="w-full space-y-6">
  <!-- Profile Card (Image 2 Style) -->
  <div class="paper-card p-6 flex flex-col items-center text-center relative overflow-hidden">
    <!-- Round Avatar from GitHub -->
    <div class="relative mb-3 group">
      <img
        src="https://github.com/Yuki-Nova.png"
        alt="Yuki-Nova"
        class="w-24 h-24 rounded-full object-cover border-2 border-border-paper shadow-md transition-transform duration-300 group-hover:scale-105"
        loading="lazy"
      />
      <span class="absolute bottom-0 right-1 w-4 h-4 rounded-full bg-emerald-500 border-2 border-surface" title="在线"></span>
    </div>

    <!-- Nickname -->
    <h3 class="text-lg font-serif font-bold text-ink tracking-wide">
      Yuki-Nova
    </h3>

    <!-- Motto / Signature -->
    <p class="text-xs font-serif text-ink-muted mt-1.5 mb-5 px-2 leading-relaxed">
      此去前路皆坦途，归来亦无悔
    </p>

    <!-- Three-Column Stats Bar (文章 | 分类 | 标签) -->
    <div class="w-full grid grid-cols-3 divide-x divide-border-paper py-2.5 border-y border-border-paper text-center">
      <a href="/poems" class="flex flex-col no-underline group hover:text-seal transition-colors">
        <span class="text-lg font-bold font-mono text-ink group-hover:text-seal">{postCount}</span>
        <span class="text-[11px] font-serif text-ink-muted mt-0.5">文章</span>
      </a>
      <a href="/categories" class="flex flex-col no-underline group hover:text-seal transition-colors">
        <span class="text-lg font-bold font-mono text-ink group-hover:text-seal">{catCount}</span>
        <span class="text-[11px] font-serif text-ink-muted mt-0.5">分类</span>
      </a>
      <a href="/tags" class="flex flex-col no-underline group hover:text-seal transition-colors">
        <span class="text-lg font-bold font-mono text-ink group-hover:text-seal">{tagCount}</span>
        <span class="text-[11px] font-serif text-ink-muted mt-0.5">标签</span>
      </a>
    </div>

    <!-- Social Links Row -->
    <div class="flex items-center justify-center gap-4 mt-5 text-ink-muted text-sm">
      <!-- GitHub -->
      <a
        href="https://github.com/Yuki-Nova"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-ink hover:scale-110 transition-all"
        title="GitHub"
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
        </svg>
      </a>

      <!-- Mail -->
      <a
        href="mailto:contact@yukinova.top"
        class="hover:text-seal hover:scale-110 transition-all"
        title="Email"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
      </a>

      <!-- RSS / Link -->
      <a
        href="/archives"
        class="hover:text-amber hover:scale-110 transition-all font-mono text-xs font-bold"
        title="文集时间线"
      >
        📅
      </a>
    </div>
  </div>

  <!-- Table of Contents (TOC) Widget (for Post Detail pages) -->
  {toc.length > 0 && (
    <div class="paper-card p-5 sticky top-20">
      <div class="flex items-center gap-2 border-b border-border-paper pb-3 mb-3 text-xs font-serif font-bold text-ink">
        <span class="w-2 h-2 rounded-full bg-seal"></span>
        <span>文章目录</span>
      </div>

      <nav class="space-y-1.5 text-xs font-serif max-h-[60vh] overflow-y-auto no-scrollbar">
        {toc.map((heading) => (
          <a
            href={`#${heading.slug}`}
            class={`block text-ink-muted hover:text-seal transition-colors py-0.5 truncate no-underline ${
              heading.depth === 2 ? 'font-medium pl-1' : 'pl-4 opacity-80'
            }`}
          >
            {heading.text}
          </a>
        ))}
      </nav>
    </div>
  )}
</aside>
